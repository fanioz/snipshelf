<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="SnipShelf.App"
             RequestedThemeVariant="Default">

    <!--
      PreferSystemTheme is deliberately False: the app owns RequestedThemeVariant through
      ISettingsService (System/Light/Dark). With it on, FluentAvaloniaTheme overwrites our
      variant whenever the OS theme changes, clobbering the user's explicit choice.
      "System" maps to ThemeVariant.Default, which follows the OS through Avalonia itself.
    -->
    <Application.Styles>
        <fa:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="True" />
    </Application.Styles>

</Application>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SnipShelf.ViewModels"
             x:Class="SnipShelf.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="8" Margin="24,16" MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="140,*" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme}"
                      MinWidth="160"
                      HorizontalAlignment="Left" />
        </Grid>

        <TextBlock Text="System follows your OS setting. Changes apply immediately."
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
    </StackPanel>

</UserControl>
